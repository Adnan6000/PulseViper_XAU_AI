# -----------------------------------------------------------------------------

01_Data/*.db
01_Data/*.sqlite
01_Data/*.sqlite3

01_Data/Backups/

*.db-journal
*.db-wal
*.db-shm


# -----------------------------------------------------------------------------
# Generated market data
# -----------------------------------------------------------------------------

01_Data/Raw/*.csv
01_Data/Raw/*.parquet
01_Data/Raw/*.feather

01_Data/Processed/*.csv
01_Data/Processed/*.parquet
01_Data/Processed/*.feather

# Forward-validation runtime boundary/state.
# Must stay local and must never be committed as repository research evidence.
01_Data/Processed/*.anchor.json

01_Data/Labels/*.csv
01_Data/Labels/*.parquet
01_Data/Labels/*.feather


